# Copy to .env and fill in real values. Never commit .env.
#
# API keys (Anthropic, Toast, Square) live in the Settings UI at
# /dashboard/settings — NOT in this file. They're stored in Postgres so
# the owner can rotate them without touching files or restarting.

# ---- Database ----
# Local dev defaults match docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://tableai:tableai@localhost:5433/tableai

# ---- App ----
APP_ENV=development
APP_BASE_DOMAIN=localhost:8001
LOG_LEVEL=INFO

# ---- POS API bases (no secrets — just endpoints) ----
TOAST_API_BASE=https://ws-api.toasttab.com
SQUARE_ENV=sandbox
