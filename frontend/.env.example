# Backend API base URL (Vite dev server proxies /api → :8000, so blank works in dev)
VITE_API_URL=

# Supabase project credentials
# Create a free project at supabase.com, then copy URL + anon key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

